{
  "name": "botlive",
  "version": "0.1.8",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "test": "vitest run",
    "desktop": "tauri dev",
    "package": "tauri build",
    "check": "tsc -b",
    "docs": "node scripts/build-docs.cjs",
    "update:prepare": "node scripts/update.cjs prepare",
    "update:check": "node scripts/update.cjs check",
    "repo:setup": "git config core.hooksPath .githooks",
    "test:updates": "node --test scripts/update.test.cjs scripts/release-manifest.test.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.9.0",
    "@xyflow/react": "^12.8.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "typescript": "~5.9.2",
    "vite": "^6.3.6",
    "vitest": "^3.2.4",
    "@playwright/test": "^1.55.0"
  }
}
