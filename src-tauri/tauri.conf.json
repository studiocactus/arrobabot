{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BotLive",
  "version": "0.1.9",
  "identifier": "studio.cactus.botlive",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "BotLive",
        "width": 1280,
        "height": 820,
        "minWidth": 680,
        "minHeight": 540
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; media-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "Seu canal, com personalidade",
    "category": "Utility",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "PortugueseBR",
          "English"
        ],
        "template": "installer.nsi",
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERBNjQyMEFDRjcxMkRCRTYKUldUbTJ4TDNyQ0JrMmp6bGhlOEcxUDc3cStROW8rck5sZjFycmQ3V0ZGNE0wQkp1MmRkOWJKMnQK",
      "endpoints": [
        "https://github.com/studiocactus/arrobabot/releases/latest/download/latest.json"
      ]
    }
  }
}
